{
  "name": "shopperexpress",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "webpack serve --mode development --progress --color",
    "build": "webpack --mode production --progress --color",
    "wp:setup": "npm run build && node tools/wp-setup.mjs",
    "theme:zip": "npm run build && node tools/theme-zip.mjs",
    "db:export": "node tools/db.mjs export",
    "db:import": "node tools/db.mjs import",
    "db:snapshot": "node tools/db.mjs snapshot",
    "db:restore": "node tools/db.mjs restore",
    "lint:php": "node tools/php.mjs",
    "lint:fix:php": "node tools/php.mjs --fix",
    "format": "prettier --write \"src/**/*.{js,scss,json}\" \"blocks/**/*.{js,scss,json}\"",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync(require('./config.json').dest, { recursive: true, force: true }); fs.rmSync('blocks/blocks-manifest.php', { force: true }); for (const dir of fs.existsSync('blocks') ? fs.readdirSync('blocks') : []) fs.rmSync(require('path').join('blocks', dir, 'build'), { recursive: true, force: true });\"",
    "clean:cache": "node -e \"require('fs').rmSync('node_modules/.cache/webpack', { recursive: true, force: true })\"",
    "convert:webp": "node tools/convert-images.mjs webp",
    "convert:avif": "node tools/convert-images.mjs avif",
    "lint:css": "stylelint \"src/**/*.{scss,sass}\" \"blocks/**/*.{scss,sass}\" --config stylelint.config.js",
    "lint:fix:css": "stylelint --fix \"src/**/*.{scss,sass}\" \"blocks/**/*.{scss,sass}\" --config stylelint.config.js",
    "lint:js": "eslint \"src/**/*.js\" \"blocks/**/*.js\" --config eslint.config.js",
    "lint:fix:js": "eslint --fix \"src/**/*.js\" \"blocks/**/*.js\" --config eslint.config.js"
  },
  "browserslist": [
    "> 0.5%",
    "not dead"
  ],
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "babel-loader": "^10.1.1",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "core-js": "^3.50.0",
    "css-loader": "^7.1.5",
    "cssnano": "^9.3.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-webpack-plugin": "^6.0.0",
    "globals": "^17.13.0",
    "image-minimizer-webpack-plugin": "^5.0.0",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.29",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.6.1",
    "postcss-sort-media-queries": "^6.7.1",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "sass-loader": "^17.0.1",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-webpack-plugin": "^5.1.0",
    "svgo": "^4.1.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "webpack-remove-empty-scripts": "^1.1.1"
  },
  "dependencies": {
    "@fancyapps/fancybox": "3.5.7",
    "bootstrap": "^4.6.2",
    "clipboard": "^2.0.11",
    "handlebars": "^4.7.10",
    "jquery": "^3.7.1",
    "jquery-mask-plugin": "^1.14.16",
    "js-cookie": "^3.0.8",
    "js-sha256": "^1.0.0",
    "popper.js": "^1.16.1",
    "slick-carousel": "1.8.0"
  },
  "version": "2.0.0"
}
